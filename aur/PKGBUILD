# Maintainer: a.key <a.key@moronet.pl>
pkgname=pam-keepassxc
pkgver=0.2.0
pkgrel=1
pkgdesc="A PAM module for KeePassXC auto-unlocking (including KDE & fingerprint support)."
arch=('x86_64')
url="https://github.com/akeyx/pam-keepassxc"
license=('MPL-2.0' 'GPL-3.0-or-later')
depends=('pam' 'keepassxc')
makedepends=('cargo' 'git')
source=("$pkgname"::'git+https://github.com/akeyx/pam-keepassxc.git')
sha256sums=('SKIP')

__TARGET="$(rustc -vV | sed -n 's/host: //p')"

prepare() {
	cd "$pkgname"
	cargo fetch --locked --target "$__TARGET"
}

build() {
	cd "$pkgname"
	export CARGO_TARGET_DIR=target
	cargo build --release --frozen --all-features --target "$__TARGET"
}

check() {
	cd "$pkgname"
	cargo test --frozen --all-features -- --skip test_dbus_verify_live
}

package() {
	cd "$pkgname"

	install -Dm0755 "target/$__TARGET/release/libpam_keepassxc.so" "$pkgdir/usr/lib/security/pam_keepassxc.so"

	install -Dm0644 -t "$pkgdir/usr/lib/systemd/user/" "systemd/keepassxc.service"
	ln -s "keepassxc.service" "$pkgdir/usr/lib/systemd/user/dbus-org.keepassxc.KeePassXC.MainWindow.service"
	install -Dm0644 -t "$pkgdir/usr/share/dbus-1/services/" "systemd/org.keepassxc.KeePassXC.MainWindow.service"
}
